{
    "version": "3.0.0",
    "description": "The Next Generation Anti-Rootkit (ARK) tool for Windows.",
    "homepage": "http://openark.blackint3.com:88",
    "license": "LGPL-2.1-only",
    "architecture": {
        "64bit": {
            "url": "http://file.blackint3.com:88/openark/OpenArk64.exe#/OpenArk.exe",
            "hash": "sha1:05c10a4345eade65873e49fdeede49cc72c23a57"
        },
        "32bit": {
            "url": "http://file.blackint3.com:88/openark/OpenArk32.exe#/OpenArk.exe",
            "hash": "sha1:753bbee6f1fcd37ff509b870224721dbce8bf671"
        }
    },
    "shortcuts": [
        [
            "OpenArk.exe",
            "OpenArk"
        ]
    ],
    "checkver": {
        "script": [
            "$json = Invoke-RestMethod http://file.blackint3.com:88/openark/version.txt",
            "$version = $json.appver",
            "$build = $json.appbd",
            "$hash64 = $json.apphash64",
            "$hash32 = $json.apphash32",
            "Write-Output \"$version $build $hash64 $hash32\""
        ],
        "regex": "(?<version>[\\d.]+) (?<build>\\d+) (?<hash64>[\\w]+) (?<hash32>[\\w]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "http://file.blackint3.com:88/openark/OpenArk64.exe#/OpenArk.exe",
                "hash": {
                    "url": "http://file.blackint3.com:88/openark/version.txt",
                    "find": "apphash64\":\"([\\w]+)"
                }
            },
            "32bit": {
                "url": "http://file.blackint3.com:88/openark/OpenArk32.exe#/OpenArk.exe",
                "hash": {
                    "url": "http://file.blackint3.com:88/openark/version.txt",
                    "find": "apphash32\":\"([\\w]+)"
                }
            }
        }
    }
}
