{
    "version": "2.0.0",
    "description": "The Next Generation Anti-Rootkit (ARK) tool for Windows.",
    "homepage": "http://openark.blackint3.com:88",
    "license": "LGPL-2.1-only",
    "architecture": {
        "64bit": {
            "url": "http://file.blackint3.com:88/v1/openark/files/openark/OpenArk-v3.0.0-202610200026/OpenArk64.exe#/OpenArk.exe",
            "hash": "sha1:6e9788b19124b51c819940465b06faba225836f9"
        },
        "32bit": {
            "url": "http://file.blackint3.com:88/v1/openark/files/openark/OpenArk-v3.0.0-202610200026/OpenArk32.exe#/OpenArk.exe",
            "hash": "sha1:8e011295d753e94c8b330f17267b9b6df1e09b6e"
        }
    },
    "shortcuts": [
        [
            "OpenArk.exe",
            "OpenArk"
        ]
    ],
    "checkver": {
        "script": [
            "$json = Invoke-RestMethod http://file.blackint3.com:88/openark/version.txt",
            "$version = $json.appver",
            "$build = $json.appbd",
            "$hash64 = $json.apphash64",
            "$hash32 = $json.apphash32",
            "Write-Output \"$version $build $hash64 $hash32\""
        ],
        "regex": "(?<version>[\\d.]+) (?<build>\\d+) (?<hash64>[\\w]+) (?<hash32>[\\w]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "http://file.blackint3.com:88/v1/openark/files/openark/OpenArk-v$matchVersion-$matchBuild/OpenArk64.exe#/OpenArk.exe",
                "hash": {
                    "url": "http://file.blackint3.com:88/openark/version.txt",
                    "find": "(?<=apphash64=)[\\w]+"
                }
            },
            "32bit": {
                "url": "http://file.blackint3.com:88/v1/openark/files/openark/OpenArk-v$matchVersion-$matchBuild/OpenArk32.exe#/OpenArk.exe",
                "hash": {
                    "url": "http://file.blackint3.com:88/openark/version.txt",
                    "find": "(?<=apphash32=)[\\w]+"
                }
            }
        }
    }
}